@using ToDoListFunctions;

@page "/"
@rendermode InteractiveServer
<PageTitle>ToDoList</PageTitle>

<h1>To-Do List</h1>

<input type="text" placeholder="Enter item name" @bind="ItemName" />
<button @onclick="AddTask">Add Task</button>

<p> List of Tasks</p>

<ul>
    @if (toDoList.Count == 0)
    {
        <p>No tasks available</p>
    }
    else
    {
        @foreach (var task in toDoList)
        {
            <li>@task</li>
        }
    }
</ul>

@code 
{
    private UniqueList<TaskList<string>> toDoList = new UniqueList<TaskList<string>>();
    private string ItemName;

    private void AddTask()
    {
        if (!string.IsNullOrEmpty(ItemName))
        {
            var task = new TaskList<string>();  // Create new TaskList for each task
            toDoList.Add(task);  // Add the TaskList to toDoList
            ItemName = string.Empty;  // Clear the input field
        }
    }
}
